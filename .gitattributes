# Enforce LF line endings for all text files
* text=auto eol=lf

# TypeScript and JavaScript files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf

# Config and data files
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Scripts
*.sh   text eol=lf
*.bat  text eol=crlf

# Binary files (no line ending conversion)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
